[Version]
Signature = "$Windows NT$"
Class = HIDClass
ClassGUID = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider = %LiberNT%
DriverVer = 11/12/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%Mfg% = Devices, NTARM

[Devices.NTARM]
%DeviceDesc% = Mxt540e_Inst, ACPI\EXYN0004
%DeviceDesc% = Mxt540e_Inst, ROOT\LIBERNTVIRTMXT540E

[Mxt540e_Inst.NT]
CopyFiles = Mxt540e_CopyFiles

[Mxt540e_CopyFiles]
mxt540e.sys
hidclass.sys
hidparse.sys

[Mxt540e_Inst.NT.Services]
AddService = mxt540e, 0x00000002, Mxt540e_Service

[Mxt540e_Service]
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\mxt540e.sys
LoadOrderGroup = Extended Base

[Strings]
LiberNT = "LiberNT Project"
Mfg = "Atmel"
DeviceDesc = "Atmel mXT540E touchscreen"
