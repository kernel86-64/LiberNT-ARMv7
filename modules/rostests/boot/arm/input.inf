[Version]
Signature = "$Windows NT$"

[AddReg]
HKLM,"SYSTEM\CurrentControlSet\Control\ServiceGroupOrder","List",0x00010000,"Boot Bus Extender","System Bus Extender","Boot File System","File System","Base","Keyboard Port","Pointer Port","Keyboard Class","Pointer Class","Video Init","Video"
HKLM,"SYSTEM\CurrentControlSet\Services\virtinput","Type",0x00010001,1
HKLM,"SYSTEM\CurrentControlSet\Services\virtinput","Start",0x00010001,1
HKLM,"SYSTEM\CurrentControlSet\Services\virtinput","ErrorControl",0x00010001,1
HKLM,"SYSTEM\CurrentControlSet\Services\virtinput","Group",0x00000000,"Keyboard Port"
HKLM,"SYSTEM\CurrentControlSet\Services\virtinput","ImagePath",0x00020000,"system32\drivers\virtinput.sys"
HKLM,"SYSTEM\CurrentControlSet\Enum\ROOT\LIBERNTVIRTIOKBD\0000","HardwareID",0x00010000,"ROOT\LIBERNTVIRTIOKBD"
HKLM,"SYSTEM\CurrentControlSet\Enum\ROOT\LIBERNTVIRTIOKBD\0000","Service",0x00000000,"virtinput"
HKLM,"SYSTEM\CurrentControlSet\Enum\ROOT\LIBERNTVIRTIOKBD\0000","Class",0x00000000,"HIDClass"
HKLM,"SYSTEM\CurrentControlSet\Enum\ROOT\LIBERNTVIRTIOKBD\0000","ClassGUID",0x00000000,"{745A17A0-74D3-11D0-B6FE-00A0C90F57DA}"
HKLM,"SYSTEM\CurrentControlSet\Enum\ROOT\LIBERNTVIRTIOKBD\0000","ConfigFlags",0x00010001,0
HKLM,"SYSTEM\CurrentControlSet\Enum\ROOT\LIBERNTVIRTIOPOINTER\0000","HardwareID",0x00010000,"ROOT\LIBERNTVIRTIOPOINTER"
HKLM,"SYSTEM\CurrentControlSet\Enum\ROOT\LIBERNTVIRTIOPOINTER\0000","Service",0x00000000,"virtinput"
HKLM,"SYSTEM\CurrentControlSet\Enum\ROOT\LIBERNTVIRTIOPOINTER\0000","Class",0x00000000,"HIDClass"
HKLM,"SYSTEM\CurrentControlSet\Enum\ROOT\LIBERNTVIRTIOPOINTER\0000","ClassGUID",0x00000000,"{745A17A0-74D3-11D0-B6FE-00A0C90F57DA}"
HKLM,"SYSTEM\CurrentControlSet\Enum\ROOT\LIBERNTVIRTIOPOINTER\0000","ConfigFlags",0x00010001,0
