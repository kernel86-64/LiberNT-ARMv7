; PROJECT:     LiberNT boot tests
; LICENSE:     GPL-3.0-or-later
; PURPOSE:     Load the WDDM core before enumerating the firmware display adapter
; COPYRIGHT:   Copyright 2026 LiberNT contributors

[Version]
Signature = "$Windows NT$"

[AddReg]
HKLM,"SYSTEM\CurrentControlSet\Control\DeviceClasses",,0x00000010
HKLM,"SYSTEM\CurrentControlSet\Control\ServiceGroupOrder","List",0x00010000,"Boot Bus Extender","System Bus Extender","Boot File System","Video Init","Video"
HKLM,"SYSTEM\CurrentControlSet\Services\dxgmms2","Type",0x00010001,1
HKLM,"SYSTEM\CurrentControlSet\Services\dxgmms2","Start",0x00010001,0
HKLM,"SYSTEM\CurrentControlSet\Services\dxgmms2","ErrorControl",0x00010001,1
HKLM,"SYSTEM\CurrentControlSet\Services\dxgmms2","Group",0x00000000,"Video Init"
HKLM,"SYSTEM\CurrentControlSet\Services\dxgmms2","ImagePath",0x00020000,"system32\drivers\dxgmms2.sys"
HKLM,"SYSTEM\CurrentControlSet\Services\dxgmms2","Tag",0x00010001,1
HKLM,"SYSTEM\CurrentControlSet\Services\dxgkrnl","Start",0x00010001,0
